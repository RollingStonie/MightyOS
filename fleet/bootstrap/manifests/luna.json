{
  "schema_version": 2,
  "agent": "luna",
  "role": "hermes-portable-dev",
  "service_account": "luna-compute",
  "watcher_source": {"path": "opt/mightyos/a008/tools/watcher/agent_watcher.py", "sha256": "eb9c2b7a18eec0f066eddb2c0e3104243dd80af084b20c5e8e98748b573f5339", "mode": "0644", "owner": "root:wheel"},
  "required_grants": ["hermes-profile", "portable-dev", "coding-worker", "git-clone-mirror", "a008-dev-instance", "trading-research"],
  "denied_grants": ["publish", "email.send", "crm.write", "trading.execute", "ollama-daemon", "contenthub-render", "always-on-power"],
  "lifecycle": {
    "initial": "registered",
    "promotion_path": ["registered", "provisioned", "probation", "ready"],
    "required_evidence": ["tailscale_scoped", "local_health", "reboot_survived", "probation_72h"]
  },
  "modules": [
    "tailscale-node",
    "a008-watcher",
    "git-clone-mirror",
    "a008-dev-instance",
    "background-worker",
    "caffeinate-wrapper",
    "hermes-profile",
    "trading-research",
    "ollama-qwen3.8",
    "meshcentral-agent"
  ],
  "network": {
    "watcher_port": 8109,
    "bind_address": "127.0.0.1",
    "tailscale_acl": "tag:luna-portable",
    "tailscale_tag": "tag:luna-portable"
  },
  "secrets": {
    "required_names": ["INFISICAL_MACHINE_IDENTITY_TOKEN", "DISCORD_BOT_TOKEN_LUNA"],
    "allowed_scopes": ["/luna/runtime", "Fleet Core/prod/luna", "/luna-runtime/meshcentral-server-url", "/luna-runtime/meshcentral-cert-hash"]
  },
  "hermes": {"enabled": true, "profile_name": "luna", "surface": "discord", "channel": "#agent-luna"},
  "launchd": {
    "kind": "daemon",
    "labels": ["com.mightyos.luna.watcher", "com.mightyos.luna.hermes-bot", "com.mightyos.luna.caffeinate", "com.mightyos.luna.ollama", "com.mightyos.luna.meshcentral-agent"],
    "run_at_load": false,
    "caffeinate_label": "com.mightyos.luna.caffeinate",
    "caffeinate_policy": "RunAtLoad=false; caffeinate -d -i -u is enforced by the Luna caffeinate wrapper only when AC power is detected via pmset; on battery the wrapper exits 0 so macOS can sleep."
  },
  "power": {
    "always_on_when_powered": false,
    "caffeinate_required_when_docked": true,
    "caffeinate_args": ["-d", "-i", "-u"]
  }
}
